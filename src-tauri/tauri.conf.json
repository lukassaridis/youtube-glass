{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Glass",
  "version": "0.2.0",
  "identifier": "com.lukas.youtubeglass",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNTU2NjQ3MEQzMTVGMjEKUldRaFh6RU5SMlpWVHBxNGNrcENtb2RCNFpPUHF5RVBmejVCall2bEpVdDE5Uk1JQ05yNG5oSncK",
      "endpoints": [
        "https://github.com/lukassaridis/youtube-glass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
